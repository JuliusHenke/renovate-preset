{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "before 8am on saturday"
  ],
  "labels": [
    "renovate"
  ],
  "onboarding": true,
  "onboardingConfig": {
      "$schema": "https://docs.renovatebot.com/renovate-schema.json",
      "extends": [
        "github>juliushenke/renovate-preset"
      ]
  },
  "prHourlyLimit": 10,
  "prConcurrentLimit": 10,
  "branchConcurrentLimit": 10,
  "automerge": false,
  "rebaseWhen": "behind-base-branch",
  "prCreation": "not-pending",
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "assignees": [
    "JuliusHenke"
  ],
  "packageRules": [
    {
      "groupName": "patch",
      "extends": [
        "github>juliushenke/renovate-preset:patch.json"
      ]
    },
    {
      "groupName": "frontend-patch",
      "extends": [
        "github>juliushenke/renovate-preset:patch.json"
      ],
      "matchFileNames": [
        "**/frontend/**"
      ]
    },
    {
      "groupName": "backend-patch",
      "extends": [
        "github>juliushenke/renovate-preset:patch.json"
      ],
      "matchFileNames": [
        "**/backend/**"
      ]
    },
    {
      "groupName": "minor",
      "extends": [
        "github>juliushenke/renovate-preset:minor.json"
      ]
    },
    {
      "groupName": "frontend-minor",
      "extends": [
        "github>juliushenke/renovate-preset:minor.json"
      ],
      "matchFileNames": [
        "**/frontend/**"
      ]
    },
    {
      "groupName": "backend-minor",
      "extends": [
        "github>juliushenke/renovate-preset:minor.json"
      ],
      "matchFileNames": [
        "**/backend/**"
      ]
    },
    {
      "description": "Only update node to active LTS versions",
      "matchPackageNames": [
        "node",
        "@types/node"
      ],
      "allowedVersions": "<=24"
    },
    {
      "description": "Label patch updates",
      "matchUpdateTypes": [
        "patch"
      ],
      "addLabels": [
        "renovate patch"
      ]
    },
    {
      "description": "Label minor updates",
      "matchUpdateTypes": [
        "minor"
      ],
      "addLabels": [
        "renovate minor"
      ]
    },
    {
      "description": "Label major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "renovate major"
      ]
    },
    {
      "description": "Label pin updates",
      "matchUpdateTypes": [
        "pin"
      ],
      "addLabels": [
        "renovate pin"
      ]
    },
    {
      "description": "Label digest updates",
      "matchUpdateTypes": [
        "digest"
      ],
      "addLabels": [
        "renovate digest"
      ]
    },
    {
      "description": "Label pin digest updates",
      "matchUpdateTypes": [
        "pinDigest"
      ],
      "addLabels": [
        "renovate pin digest"
      ]
    },
    {
      "description": "Label lock file maintenance updates",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "addLabels": [
        "renovate lock file maintenance"
      ]
    },
    {
      "description": "Label rollback updates",
      "matchUpdateTypes": [
        "rollback"
      ],
      "addLabels": [
        "renovate rollback"
      ]
    },
    {
      "description": "Label replacement updates",
      "matchUpdateTypes": [
        "replacement"
      ],
      "addLabels": [
        "renovate replacement"
      ]
    },
    {
      "description": "Label bump updates",
      "matchUpdateTypes": [
        "bump"
      ],
      "addLabels": [
        "renovate bump"
      ]
    }
  ]
}
