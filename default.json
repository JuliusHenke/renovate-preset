{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "before 8am on saturday"
  ],
  "labels": [
    "renovate"
  ],
  "prHourlyLimit": 10,
  "prConcurrentLimit": 10,
  "branchConcurrentLimit": 10,
  "automerge": false,
  "rebaseWhen": "behind-base-branch",
  "prCreation": "not-pending",
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "assignees": [
    "JuliusHenke"
  ],
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ]
  },
  "packageRules": [
    {
      "groupName": "patch",
      "extends": [
        "./patch"
      ],
      "matchUpdateTypes": [
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ]
    },
    {
      "groupName": "frontend-patch",
      "extends": [
        "./patch"
      ],
      "matchFileNames": [
        "**/frontend/**"
      ],
      "matchUpdateTypes": [
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ]
    },
    {
      "groupName": "backend-patch",
      "extends": [
        "./patch"
      ],
      "matchFileNames": [
        "**/backend/**"
      ],
      "matchUpdateTypes": [
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ]
    },
    {
      "groupName": "minor",
      "extends": [
        "./minor"
      ],
      "matchUpdateTypes": [
        "minor"
      ]
    },
    {
      "groupName": "frontend-minor",
      "extends": [
        "./minor"
      ],
      "matchFileNames": [
        "**/frontend/**"
      ],
      "matchUpdateTypes": [
        "minor"
      ]
    },
    {
      "groupName": "backend-minor",
      "extends": [
        "./minor"
      ],
      "matchFileNames": [
        "**/backend/**"
      ],
      "matchUpdateTypes": [
        "minor"
      ]
    },
    {
      "description": "Only update Node.js to LTS majors",
      "matchDepNames": [
        "node",
        "@types/node"
      ],
      "allowedVersions": "<=26"
    },
    {
      "description": "Label patch updates",
      "matchUpdateTypes": [
        "patch"
      ],
      "addLabels": [
        "renovate patch"
      ]
    },
    {
      "description": "Label minor updates",
      "matchUpdateTypes": [
        "minor"
      ],
      "addLabels": [
        "renovate minor"
      ]
    },
    {
      "description": "Label major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "renovate major"
      ]
    },
    {
      "description": "Label pin updates",
      "matchUpdateTypes": [
        "pin"
      ],
      "addLabels": [
        "renovate pin"
      ]
    },
    {
      "description": "Label digest updates",
      "matchUpdateTypes": [
        "digest"
      ],
      "addLabels": [
        "renovate digest"
      ]
    },
    {
      "description": "Label pin digest updates",
      "matchUpdateTypes": [
        "pinDigest"
      ],
      "addLabels": [
        "renovate pin digest"
      ]
    },
    {
      "description": "Label lock file maintenance updates",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "addLabels": [
        "renovate lock file maintenance"
      ]
    },
    {
      "description": "Label rollback updates",
      "matchUpdateTypes": [
        "rollback"
      ],
      "addLabels": [
        "renovate rollback"
      ]
    },
    {
      "description": "Label replacement updates",
      "matchUpdateTypes": [
        "replacement"
      ],
      "addLabels": [
        "renovate replacement"
      ]
    },
    {
      "description": "Label bump updates",
      "matchUpdateTypes": [
        "bump"
      ],
      "addLabels": [
        "renovate bump"
      ]
    }
  ]
}
